# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=openai/gpt-5.4-mini
# ELEVENLABS_API_KEY=              # alternativa ao setup (voz da entrevistadora)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# LIVEKIT_URL=                    # wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# ELEVENLABS_AGENT_ID=             # alternativa ao setup (agente conversacional que conduz a entrevista)
# ELEVENLABS_PHONE_NUMBER_ID=      # só para a ligação telefônica
# ELEVENLABS_WEBHOOK_SECRET=       # valida o aviso de pós-conversa da ElevenLabs
# NOVA_SENHA_ADMIN=                # redefine a senha da conta de administrador na próxima subida
# APP_URL=                         # endereço público do app, usado nos links enviados por aviso
# GOOGLE_CLIENT_ID_APP=            # credenciais da suíte (equipe técnica) para "Conectar meu Gmail" em /setup
# GOOGLE_CLIENT_SECRET_APP=
# MICROSOFT_CLIENT_ID_APP=         # credenciais da suíte (equipe técnica) para "Conectar meu Outlook" em /setup
# MICROSOFT_CLIENT_SECRET_APP=
