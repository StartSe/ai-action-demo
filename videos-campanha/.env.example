# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Creative Flow: imagens, edição e vídeos. Alternativa ao cartão MuAPI em /setup.
MUAPI_API_KEY=
