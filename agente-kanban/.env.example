# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# APP_URL=http://localhost:3000
# APP_NAME=Agente de Kanban
# KANBAN_AI_PROVIDER=openrouter   # openrouter ou chatgpt (Codex com login dedicado)
# KANBAN_CODEX_MODEL=             # opcional: modelo disponível na sua assinatura
# ZAPIER_MCP_URL=                 # URL secreta do servidor em mcp.zapier.com; prefira a tela Conexões

# Trello: alternativa ao setup. Chave e token em https://trello.com/power-ups/admin;
# ID do quadro pode ser escolhido em /setup depois de salvar a chave e o token.
# TRELLO_API_KEY=
# TRELLO_API_TOKEN=
# TRELLO_BOARD_ID=

# Chave pública do Power-Up do Trello desta suíte (não é segredo, ver lib/integracoes.ts).
# Definida uma vez por quem publica o app; com ela, o executivo só clica em "Autorizar no
# Trello" e nunca precisa colar uma chave própria.
# TRELLO_API_KEY_APP=

# MCP_TAREFAS_URL=                 # alternativa ao setup: endereço do quadro de tarefas conectado por MCP
# MCP_TAREFAS_CODIGO=
# GOOGLE_CLIENT_ID_APP=            # credenciais da suíte (equipe técnica) para "Conectar meu Gmail" em /setup
# GOOGLE_CLIENT_SECRET_APP=
# MICROSOFT_CLIENT_ID_APP=         # credenciais da suíte (equipe técnica) para "Conectar meu Outlook" em /setup
# MICROSOFT_CLIENT_SECRET_APP=
