# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# APOLLO_API_KEY=                  # alternativa ao setup (busca de leads na Apollo.io)
# BRIGHTDATA_API_KEY=              # alternativa ao setup: MCP HTTP com pro=1 (busca e dados públicos)
# BRIGHTDATA_TETO_CONSULTAS=60      # máximo por prospecção; não precisa configurar zonas
# MCP_CRM_URL=                     # alternativa ao setup: endereço do servidor MCP do CRM (HubSpot, Zendesk, Intercom...)
# MCP_CRM_CODIGO=
# GOOGLE_CLIENT_ID_APP=            # credenciais da suíte (equipe técnica) para "Conectar meu Gmail" em /setup
# GOOGLE_CLIENT_SECRET_APP=
# MICROSOFT_CLIENT_ID_APP=         # credenciais da suíte (equipe técnica) para "Conectar meu Outlook" em /setup
# MICROSOFT_CLIENT_SECRET_APP=

# Fontes opcionais de pesquisa (também configuráveis pela interface)
# EXA_API_KEY=
# EXA_TIPO_BUSCA=deep              # auto, deep-lite, deep ou deep-reasoning
# EXA_TETO_CONSULTAS=10
# TAVILY_API_KEY=
# TAVILY_PROFUNDIDADE=advanced     # basic ou advanced
# TAVILY_TETO_CONSULTAS=10
# SEARCHAPI_API_KEY=
# SEARCHAPI_TETO_CONSULTAS=10
