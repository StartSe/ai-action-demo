# Opcional: as conexões podem ser configuradas pela interface.
# Dados, conta, mapas e credenciais persistem neste diretório.
DATA_DIR=./data
AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# AI_MODEL=openrouter/auto
# A .venv local é detectada automaticamente após npm run setup:youtube.
# PYTHON_PATH=/caminho/para/outro/python
# Proxy residencial HTTP/HTTPS, se o YouTube bloquear o IP do servidor (Render).
# Use a URL fornecida pelo seu provedor, com usuário/senha codificados para URL.
# YOUTUBE_PROXY_URL=
# Recuperação da conta: definir temporariamente e remover após entrar.
# NOVA_SENHA_ADMIN=
