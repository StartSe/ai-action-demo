# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_VISAO=inclusionai/ling-3.0-flash-vl:free   # modelo que lê a captura
# SCREENSHOTONE_ACCESS_KEY=        # opcional: captura a página a partir do endereço do site

# APP_URL=https://seu-app.onrender.com  # necessário para o build dos sites no Render
# RENDER_API_KEY=
# RENDER_OWNER_ID=tea-...
# RENDER_SITE_REPO=https://github.com/StartSe/ai-action-app-deploy
# RENDER_SITE_BRANCH=deploy-clone-site
# RENDER_SITE_ROOT=site-build
