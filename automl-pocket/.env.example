# Copie para .env, preencha AUTH_SECRET e suba com `docker compose up --build`.
# Os demais valores já servem para desenvolvimento. O código lê EXATAMENTE
# estas 16 variáveis — nada mais (web: 14, worker: 7, com 5 em comum).

# --- Obrigatórias ------------------------------------------------------------
# Segredo que assina sessões e cookies do Better Auth. Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do app (origem dos cookies e dos links do Better Auth).
BETTER_AUTH_URL=http://localhost:3000
# Redis da fila BullMQ (web enfileira, worker consome). "redis" é o serviço do compose.
REDIS_URL=redis://redis:6379

# --- Armazenamento -----------------------------------------------------------
# Arquivo SQLite compartilhado por web e worker (volume "data" do compose).
SQLITE_PATH=/data/pocket.db
# Diretório de planilhas enviadas, parquet e artefatos de modelo (mesmo volume).
UPLOAD_DIR=/data/uploads
# Tamanho máximo de cada upload, em megabytes.
MAX_UPLOAD_MB=25

# --- Treino ------------------------------------------------------------------
# Treinos simultâneos na fila "training"; o web lê o mesmo valor para estimar a espera.
TRAINING_CONCURRENCY=2
# Núcleos por treino (n_jobs do Random Forest/XGBoost): TRAINING_CONCURRENCY × MODEL_N_JOBS ≈ vCPUs.
MODEL_N_JOBS=2
# Threads BLAS/OpenMP por processo (cobre o MLP, que ignora n_jobs).
OMP_NUM_THREADS=2
# Teto de linhas por treino; vazio = sem limite (default do código).
TRAINING_MAX_ROWS=

# --- API/segurança -----------------------------------------------------------
# Máximo de linhas por chamada em POST /api/v1/predict (acima disso responde 413).
API_PREDICT_MAX_ROWS=500
# Requisições cross-origin às rotas internas: off | report (só audita) | enforce (403).
INTERNAL_ORIGIN_MODE=report
# Falhas de autenticação da API/MCP: report (só audita) | enforce (429 após 10 falhas/min por IP).
API_AUTH_FAIL_MODE=report

# --- Avançado ----------------------------------------------------------------
# true = o worker pausa em needs_review planilhas com layout duvidoso (tela "Revisar planilha").
LAYOUT_REVIEW_ENABLED=false
# Pasta do dataset de exemplo; o default é a cópia embutida na imagem do web.
# SEED_ASSETS_DIR=/app/seed-assets
# 0 desliga o backfill do dataset de exemplo no boot do web (rede de segurança do /setup).
SEED_EXAMPLES_ON_BOOT=1
