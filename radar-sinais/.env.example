# Nenhuma variável é obrigatória. Configure tudo em /setup no navegador (fica salvo em SQLite em ./data).
# Variáveis de ambiente, se definidas, têm prioridade sobre o que foi salvo no setup.
# DATA_DIR=./data                  # onde fica o banco app.sqlite
# AI_PROVIDER=openrouter          # openrouter ou chatgpt; prefira escolher em Configurações
# CHATGPT_MODEL=                  # vazio usa Automático; sessão em DATA_DIR/chatgpt
# OPENROUTER_API_KEY=              # alternativa ao setup
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GOOGLE_CLIENT_ID_APP=             # credenciais da suíte (equipe técnica) para "Conectar meu Gmail" em /setup
# GOOGLE_CLIENT_SECRET_APP=
# MICROSOFT_CLIENT_ID_APP=         # credenciais da suíte (equipe técnica) para "Conectar meu Outlook" em /setup
# MICROSOFT_CLIENT_SECRET_APP=

# Bright Data MCP HTTP (pro=1 habilitado automaticamente)
BRIGHTDATA_API_TOKEN=

# Busca web e conversas no X (também disponíveis em Configurações)
EXA_API_KEY=
TAVILY_API_KEY=
XAI_API_KEY=
XAI_SEARCH_MODEL=grok-4.6
# Modelo dedicado à síntese de sinais e ontologia; vazio usa OPENROUTER_MODEL
OPENROUTER_MODEL_ONTOLOGIA=
# Cache de busca opcional, TTL de cinco minutos; requer ambos os valores
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
