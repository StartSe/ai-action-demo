# Nenhuma variável é obrigatória: ChatGPT e OpenRouter são conectados em /configuracoes.
# Planilhas, conversas, decisões do harness, conta e credenciais ficam neste diretório.
# DATA_DIR=./data
# Variáveis, quando definidas, têm prioridade sobre o que foi salvo na tela.
# OPENROUTER_API_KEY=
# AI_PROVIDER=chatgpt            # chatgpt | openrouter
# AI_MODEL=                      # vazio = automático
# AI_MODEL_FORTE=                # modelo para análises complexas (opcional)
# Recuperação da conta: definir temporariamente e remover após entrar.
# NOVA_SENHA_ADMIN=
